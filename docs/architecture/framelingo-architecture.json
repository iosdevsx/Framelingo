          "stateMutation": "Clears or publishes HomeViewModel.errorMessage.",
          "errors": [
            "Could not open project"
          ],
          "source": "AppTarget/Modules/Features/HomeFeature/Sources/Impl/ViewModels/HomeViewModel.swift"
